/* HWInfo - 浅色现代主题 */

/* === 全局 === */
* {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #f5f5f5;
}

QWidget {
    background-color: #f5f5f5;
    color: #333333;
}

/* === 左侧导航列表 === */
#navList {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #e8e8e8;
    padding: 8px 4px;
    outline: none;
}

#navList::item {
    padding: 10px 12px;
    margin: 2px 4px;
    border-radius: 6px;
    color: #333333;
}

#navList::item:hover {
    background-color: #f0f4ff;
}

#navList::item:selected {
    background-color: #e3edff;
    color: #1a6dff;
    font-weight: bold;
}

/* === 工具栏 === */
QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e8e8e8;
    padding: 4px 8px;
    spacing: 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 12px;
    color: #333333;
}

QToolBar QToolButton:hover {
    background-color: #f0f4ff;
    border-color: #d0e0ff;
}

QToolBar QToolButton:pressed {
    background-color: #e3edff;
}

/* === 状态栏 === */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e8e8e8;
    color: #666666;
    font-size: 12px;
}

/* === 滚动区域 === */
QScrollArea {
    background-color: #f5f5f5;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #f5f5f5;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #c8c8c8;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 0;
}

/* === 分组框（卡片） === */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    margin-top: 16px;
    padding: 20px 12px 12px 12px;
    font-weight: bold;
    font-size: 13px;
    color: #333333;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 2px 8px;
    color: #1a6dff;
    background-color: #ffffff;
    border-radius: 4px;
}

/* === 表格 === */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #fafafa;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    gridline-color: #f0f0f0;
    selection-background-color: #e3edff;
    selection-color: #1a6dff;
}

/* === 总览摘要列表 === */
#overviewTable {
    background-color: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    outline: none;
}

#overviewTable::item {
    padding: 4px 12px;
    border: none;
}

QTableWidget::item {
    padding: 6px 10px;
    border: none;
    background-color: transparent;
}

QHeaderView::section {
    background-color: #fafafa;
    border: none;
    border-bottom: 1px solid #e8e8e8;
    padding: 8px 10px;
    font-weight: bold;
    color: #555555;
}

/* === 按钮 === */
QPushButton {
    background-color: #1a6dff;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0d5ce6;
}

QPushButton:pressed {
    background-color: #0a4bc2;
}

QPushButton:disabled {
    background-color: #cccccc;
    color: #999999;
}

/* === 复选框 === */
QCheckBox {
    spacing: 10px;
    padding: 5px 0;
    color: #333333;
    font-size: 14px;
}

/* === 标签 === */
QLabel {
    color: #333333;
}

/* === 表单布局标签 === */
QFormLayout QLabel {
    color: #555555;
}
